{
  // 多根工作区（Multi-root Workspace）配置：
  // uni-app x 语言服务（DCloud 插件）识别项目的关键是 packages/hs-his-app/tsconfig.json：
  // tsserver 从文件向上找最近的 tsconfig，以其目录为项目根检测 manifest.json/pages.json/App.uvue/main.uts。
  // 有了该 tsconfig 后，单根（直接打开仓库根）和本多根工作区两种打开方式均有代码提示。
  // 使用方式：菜单「文件 → 打开工作区」选择本文件；直接打开仓库根目录也可。
  "folders": [{ "name": "收银（根）", "path": "." }, { "name": "app（uni-app x）", "path": "packages/app" }],
  // window 级配置只能写在 .code-workspace 或用户设置里，子文件夹的 .vscode/settings.json 中会被忽略。
  // Prettier 默认不认领 uts/uvue 这类非标准语言，必须通过 documentSelectors 注册后保存才会格式化。
  // 直接打开仓库根目录（单根窗口）时，同样的配置已写在根 .vscode/settings.json 中，两种打开方式都能格式化。
  "settings": {
    "prettier.documentSelectors": ["**/*.uts", "**/*.uvue"],
    "typescript.tsserver.log": "verbose"
  }
}
