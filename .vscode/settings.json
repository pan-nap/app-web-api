{
  // eslint 保存格式化
  "eslint.enable": true,
  "eslint.run": "onType",
  "eslint.options": {
    "extensions": [".js", ".ts", ".jsx", ".tsx", ".vue"]
  },
  // 编辑器保存格式化
  "editor.codeActionsOnSave": {
    "source.fixAll": "never",
    "source.fixAll.eslint": "explicit"
  },
  // .ts 文件格式化程序
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  // .vue 文件格式化程序
  "[vue]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  // 兜底：直接打开仓库根目录（非 收银.code-workspace 多根模式）时，documentSelectors 写在根 folder 设置里才能生效；
  // 多根模式下以 收银.code-workspace 的 settings 为准（两处内容需保持一致）
  "prettier.documentSelectors": ["**/*.uts", "**/*.uvue"],
  "[uts]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[uvue]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  // 操作时作为单词分隔符的字符
  "editor.wordSeparators": "`~!@#%^&*()=+[{]}\\|;:'\",.<>/?",
  // 一个制表符等于的空格数
  "editor.tabSize": 2,
  "editor.multiCursorLimit": 10000,
  // 行尾字符
  "files.eol": "\n",
  // 保存到额时候用使用 prettier进行格式化
  "editor.formatOnSave": true,
  // css文件忽略警告
  "css.lint.unknownAtRules": "ignore",
  "prettier.semi": true, // 分号
  "prettier.singleQuote": false, // 单引号
  "prettier.trailingComma": "none", // 去掉结尾的逗号
  "prettier.printWidth": 150,
  "vue.codeActions.enabled": false,
  "typescript.tsdk": "node_modules/typescript/lib",
  "git.ignoreLimitWarning": true
}
