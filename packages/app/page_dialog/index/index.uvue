<template>
	<!-- dialogPage：独立页面，不进入页面栈，由 uni.openDialogPage 打开 -->
	<view class="dlg-page" @tap="closeByMask">
		<view class="dlg-card" @tap.stop>
			<text class="dlg-card__title">dialogPage 弹窗</text>
			<text class="dlg-card__content">
				这是一个独立的 dialogPage 页面（pages/dialog/index），
				通过 uni.openDialogPage 打开，可自定义遮罩、动画、内容与返回逻辑，
				自定义能力最强，但需要独立页面与事件通信配合。
			</text>

			<!-- 演示：从宿主页面传入参数 -->
			<view class="dlg-card__params" v-if="scene != ''">
				<text class="dlg-card__params-label">接收参数 scene</text>
				<text class="dlg-card__params-value">{{ scene }}</text>
			</view>

			<view class="dlg-card__footer">
				<button class="dlg-btn dlg-btn--default" @tap="cancel">取消</button>
				<button class="dlg-btn dlg-btn--primary" @tap="confirm">确定</button>
			</view>
		</view>
	</view>
</template>

<script setup >
const scene = ref<string>('')

onLoad((options: OnLoadOptions) => {
	const sceneValue = options['scene']
	if (sceneValue != null) {
		scene.value = sceneValue as string
	}
})

// 点击遮罩关闭
const closeByMask = () => {
	// uni.closeDialogPage({
	// 	animationType: 'fade-out',
	// 	animationDuration: 200
	// })
}

const cancel = () => {
	// 通过事件总线把结果回传宿主页面
	emitResult('cancel')
	uni.closeDialogPage({
		animationType: 'fade-out',
		animationDuration: 200
	})
}

const confirm = () => {
	emitResult('confirm')
	uni.closeDialogPage({
		animationType: 'fade-out',
		animationDuration: 200
	})
}

const emitResult = (action: string) => {
	const result = new UTSJSONObject()
	result['action'] = action
	uni.$emit('dialogPageResult', result)
}
</script>

