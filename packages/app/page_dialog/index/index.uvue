	.dlg-page {
		flex: 1;
		background-color: rgba(0, 0, 0, 0.45);
		display: flex;
		flex-direction: row;
		justify-content: center;
		align-items: center;
	}

	.dlg-card {
		width: 640rpx;
		background-color: #ffffff;
		border-radius: 24rpx;
		padding: 48rpx 40rpx 40rpx;
		display: flex;
		flex-direction: column;
	}

	.dlg-card__title {
		font-size: 36rpx;
		font-weight: 700;
		color: #191a1b;
	}

	.dlg-card__content {
		margin-top: 20rpx;
		font-size: 28rpx;
		line-height: 44rpx;
		color: #636669;
	}

	.dlg-card__params {
		margin-top: 24rpx;
		background-color: #f0f3f7;
		border-radius: 12rpx;
		padding: 16rpx 20rpx;
		display: flex;
		flex-direction: column;
	}

	.dlg-card__params-label {
		font-size: 22rpx;
		color: #738199;
	}

	.dlg-card__params-value {
		margin-top: 8rpx;
		font-size: 28rpx;
		color: #2376f3;
		font-weight: 600;
	}

	.dlg-card__footer {
		margin-top: 40rpx;
		display: flex;
		flex-direction: row;
		justify-content: flex-end;
	}

	.dlg-btn {
		margin-left: 24rpx;
		width: 180rpx;
		font-size: 30rpx;
		border-radius: 12rpx;
	}

	.dlg-btn--default {
		background-color: #f0f3f7;
		color: #40536d;
	}

	.dlg-btn--primary {
		background-color: #2376f3;
		color: #ffffff;
	}
</style>
