<template>
	<view v-if="!hideBar" :style="[{height: `${44+statusBarHeight}px`, paddingTop: `${statusBarHeight}px`}]" class="bg-white flex flex-row items-center">
		<view class="basis-[100rpx] shrink-0 px-20 h-[44px] flex flex-row justify-center items-center">
			<view v-if="!hideBack" @click="navBack" class="flex-1 flex flex-row justify-center items-center">
				<text class="text-40 text-[#333]">←</text>
			</view>
		</view>
		<view class="flex-1 flex flex-row justify-center items-center">
			<text v-if="title != ''" class="font-bold">
				{{title}}
			</text>
			<slot v-else name="title"></slot>
		</view>
		<view class="basis-[100rpx] shrink-0 px-20 h-[44px] flex flex-row justify-center items-center">
			<slot name="right"></slot>
		</view>
	</view>
	<slot name="header"></slot>
	<!-- 内容滚动区域 -->
	<scroll-view v-if="scroll" :scroll-y="true" class="flex-1 py-10 flex flex-col bg-[#eef1f7]">
		<slot></slot>
	</scroll-view>
	<view v-else class="flex-1 py-10 flex flex-col bg-[#eef1f7]">
		<slot></slot>
	</view>
</template>

<script setup>
	import { useUserStore } from '@/store/user.uts'

	type Props = {
		hideBar ?: boolean
		hideBack ?: boolean
		title ?: string
		title2? : string
		verifyLogin ?: boolean
		scroll ?: boolean
	}

	const props = withDefaults(defineProps<Props>(), {
		hideBar: false,
		hideBack: false,
		title: '',
		title2: '',
		verifyLogin: true,
		scroll: true,
	})
	const slots = useSlots()
	const userStore = useUserStore()
	const { statusBarHeight = 0 } = uni.getWindowInfo()

	onLoad(() => {
		if (props.verifyLogin) {
			userStore.toLogin()
		}
	})
	onPageShow(() => {
		userStore.setTitle(props.title2 != '' ? props.title2 : props.title)
	})

	const navBack = () => {
		// #ifdef H5
		window.history.go(-1)
		// #endif
		// #ifndef H5
		uni.navigateBack();
		// #endif
	}
</script>
