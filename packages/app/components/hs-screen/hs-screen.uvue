<template>
	<view class="flex-1 flex flex-col bg-white" :style="[{ paddingTop: `${statusBarHeight}px` }]">
		<view v-if="!hideBar" style="height: 44px" class="bg-white flex flex-row items-center">
			<view class="basis-[100rpx] shrink-0 px-20 h-[44px] flex flex-row justify-center items-center">
				<view v-if="!hideBack" @click="navBack" class="flex-1 flex flex-row justify-center items-center">
					<text class="text-40 text-[#333]">←</text>
				</view>
			</view>
			<view class="flex-1 flex flex-row justify-center items-center">
				<text v-if="title != ''" class="font-bold">
					{{ title }}
				</text>
				<slot v-else name="title"></slot>
			</view>
			<view class="basis-[100rpx] shrink-0 px-20 h-[44px] flex flex-row justify-center items-center">
				<slot name="right"></slot>
			</view>
		</view>
		<slot name="header"></slot>
		<!-- 内容区域：外层 flex-1 把高度锁定为一屏，Web 端内容不会撑出页面、页面默认滚动不会触发，
				故用 scroll-view 做内容区内部滚动（蒸汽模式纵向滚动默认开启，不要写 scroll-y）；
				页面自带滚动容器时传 :scroll="false" 回退为 view，避免双层 scroll-view 嵌套 -->
		<scroll-view
			v-if="scroll"
			class="flex-1 py-10 flex flex-col bg-[#eef1f7]"
			:refresher-enabled="refresherEnabled"
			:refresher-triggered="refresherTriggered"
			refresher-default-style="none"
			@scroll="(e: any) => emit('scroll', e)"
			@scrolltolower="emit('scrolltolower')"
			@scrolltoupper="emit('scrolltoupper')"
			@refresherrefresh="emit('refresherrefresh')"
		>
			<slot></slot>
			<!-- 自定义下拉刷新提示：slot="refresher" 必须设宽高，且安卓/iOS 下不能放在首个子节点位置（官方 scroll-view 文档） -->
			<view v-if="refresherEnabled" slot="refresher" class="h-[45px] flex flex-row items-center justify-center">
				<text class="text-28 text-[#999]">下拉刷新中。。。</text>
			</view>
		</scroll-view>
		<view v-else class="flex-1 py-10 flex flex-col bg-[#eef1f7]">
			<slot></slot>
		</view>
	</view>
</template>

<script setup>
import { useUserStore } from '@/store/user.uts'

type Props = {
	hideBar ?: boolean
	hideBack ?: boolean
	title ?: string
	title2? : string
	verifyLogin ?: boolean
	scroll ?: boolean
	refresherEnabled ?: boolean
	refresherTriggered ?: boolean
}

const props = withDefaults(defineProps<Props>(), {
	hideBar: false,
	hideBack: false,
	title: '',
	title2: '',
	verifyLogin: true,
	scroll: true,
	refresherEnabled: false,
	refresherTriggered: false,
})

// 透传内容区 scroll-view 的滚动事件，页面在 <hs-screen> 上直接监听即可
const emit = defineEmits(['scroll', 'scrolltolower', 'scrolltoupper', 'refresherrefresh'])
const slots = useSlots()
const userStore = useUserStore()
const { statusBarHeight = 0 } = uni.getWindowInfo()

onLoad(() => {
	if (props.verifyLogin) {
		userStore.toLogin()
	}
})
onPageShow(() => {
	userStore.setTitle(props.title2 != '' ? props.title2 : props.title)
})

const navBack = () => {
	// #ifdef H5
	window.history.go(-1)
	// #endif
	// #ifndef H5
	uni.navigateBack();
	// #endif
}
</script>
