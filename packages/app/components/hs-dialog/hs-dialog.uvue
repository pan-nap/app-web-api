<template>
	<view>
		<view @tap="onTriggerTap">
			<slot></slot>
		</view>
		<page-container
			:show="modelValue"
			:position="currentPosition"
			:round="props.round"
			:overlay="props.overlay"
			:overlay-style="overlayStyle"
			:custom-style="customStyle"
			:duration="props.duration"
			:z-index="props.zIndex"
			:close-on-slide-down="props.closeOnSlideDown"
			@clickoverlay="onClickOverlay"
			@afterleave="onAfterLeave"
		>
			<slot name="content"></slot>
		</page-container>
	</view>
</template>

<script setup>
type Props = {
	// v-model 双向绑定显隐
	modelValue ?: boolean
	// 弹出位置：top / bottom / left / right / center
	position ?: string
	// 是否显示圆角
	round ?: boolean
	// 是否显示遮罩
	overlay ?: boolean
	// 点击遮罩是否关闭（默认关闭，按使用方场景自行开关）
	closeOnClickOverlay ?: boolean
	// 下滑一段距离后是否关闭（仅 bottom 场景生效）
	closeOnSlideDown ?: boolean
	// 自定义遮罩样式
	overlayStyle ?: string
	// 自定义弹出层样式
	customStyle ?: string
	// 动画时长（毫秒）
	duration ?: number
	// z-index 层级
	zIndex ?: number
}

const props = withDefaults(defineProps<Props>(), {
	modelValue: false,
	position: 'bottom',
	round: false,
	overlay: true,
	closeOnClickOverlay: false,
	closeOnSlideDown: false,
	overlayStyle: '',
	customStyle: '',
	duration: 300,
	zIndex: 100
})

const emit = defineEmits<{
	(e: 'update:modelValue', value: boolean): void
}>()
const currentPosition = ref<string>(props.position)


type DialogConfig = {
	position ?: string
}

/**
 * 命令式打开弹窗
 * 支持通过 config 覆盖位置等配置，如 open({ position: 'center' })
 */
const open = (config ?: DialogConfig) => {
	if (config?.position != null) {
		currentPosition.value = config.position!
	}
	emit('update:modelValue', true)
}

/**
 * 命令式关闭弹窗（触发离开动画）
 */
const close = () => {
	emit('update:modelValue', false)
}

/**
 * show() 方法别名（兼容 el-popover 风格）
 */
const show = (config ?: DialogConfig) => open(config)

/**
 * hide() 方法别名（兼容 el-popover 风格）
 */
const hide = () => close()

/**
 * 触发模式：点击默认插槽（触发元素）打开弹窗
 */
const onTriggerTap = () => {
	open()
}

const onAfterLeave = () => {
	emit('update:modelValue', false)
}

const onClickOverlay = (_e: UniPointerEvent) => {
	if (props.closeOnClickOverlay) {
		close()
	}
}

// 暴露命令式实例方法，页面可通过 ref 拿到后直接调用
defineExpose({ open, close, show, hide })
</script>
