<template>
  <view>
    <view>
      <button type="button" class="mt-10 mb-10" @tap="onGetApi()">获取API</button>
      <view>
        <input
          placeholder="当前swagger地址"
          v-model="state.swagger"
          class="border-solid border-1 border-[#ABB2BF] h-[3.5vh] pl-12 rd-12"
        />
      </view>
    </view>
    <view v-if="state.apis.length > 0">
      <view class="py-1vw">
        <input
            placeholder="搜索API"
            v-model="state.search"
            class="border-solid border-1 border-[#ABB2BF] h-[3.5vh] pl-12 rd-12"
            @blur="onSearch"
          />
      </view>
    </view>
    <view v-if="state.searchApi.length > 0">
      <scroll-view class="h-[70vh] bg-[#272822] p-20">
        <!-- 整行代码放在同一个 text 内，子 text 仅做行内高亮，避免选中复制时被拆成多行 -->
        <!-- token 间空格必须用 &nbsp;：普通空格会被 text 节点首尾剪裁掉 -->
        <text selectable class="text-white">
          <text class="text-[#F92672]">import&nbsp;</text>
          <text class="text-white">request&nbsp;</text>
          <text class="text-[#F92672]">from&nbsp;</text>
          <text class="text-[#E6DB5B]">'@/utils/request';\n\n</text>
        </text>
        <view
          v-for="(api, idx) in state.searchApi"
          :key="idx"
          class="text-white bg-[#272822]"
        >
          <text selectable class="text-[#8A8C99]">/**\n</text>
          <text selectable class="text-[#8A8C99]">* 接口分类: {{ api.description }} - {{ api.tags }}\n</text>
          <text selectable class="text-[#8A8C99]">* 接口名称: {{ api.summary }}\n</text>
          <text selectable class="text-[#8A8C99]">* 接口地址: {{ api.url }}\n</text>
          <text selectable class="text-[#8A8C99]">* 请求方式: {{ api.method }}\n</text>
          <text v-for="(parame, s1) in api.parameters" :key="s1">
            <text selectable class="text-[#8A8C99]">
              *
              <text selectable class="text-[#C678DD]">@param</text>
              <text selectable class="text-[#E5C07B]">&nbsp;{[{{ parame.type }}]}</text>
              <text selectable class="text-[#E06C75]">&nbsp;{{ parame.name }}</text>
              [{{ parame.description }}] 是否必填: {{ parame.required ? "是" : "否" }}\n
            </text>
          </text>
          <text selectable class="text-[#8A8C99]">
            *
            <text selectable class="text-[#C678DD]">@return</text>
            <text selectable class="text-[#E5C07B]">&nbsp;{[Promise&lt;any&gt;]}</text>
            接口响应数据\n
          </text>
          <text selectable class="text-[#8A8C99]">*/\n</text>
          <!-- 方法体 + request 调用：一整个 text 节点，换行由字符串里的 \n 控制 -->
          <text selectable class="text-white">
            <text class="text-[#F92672]">export&nbsp;</text>
            <text class="text-[#66D9EF]">function&nbsp;</text>
            <text class="text-[#6AC62E]">{{ onFunctionName(api.url, api.method) }}</text>
            <text>(data: any = {}) {\n</text>
            <text class="text-[#F92672]">&nbsp;&nbsp;return&nbsp;</text>
            <text class="text-[#66D9EF]">request</text>
            <text>('{{ api.url }}', data, '{{ api.method }}');\n</text>
            <text>}\n\n</text>
          </text>
        </view>
      </scroll-view>
    </view>
  </view>
</template>

<script setup>
type ApiItem = {
  description: string
  tags: string
  summary: string
  url: string
  method: string
  parameters: ApiParameter[]
  proxy: string
}

type ApiParameter = {
  type: string
  name: string
  description: string
  required: boolean
}

const state = reactive({
  show: false,
  index: 0,
  searchApi: [] as ApiItem[],
  search: "",
  ids: [] as string[],
  apis: [] as ApiItem[],
  swagger: "/sf-web"
})

/**
 * 请求接口文档
 * 注意：不加 dataType:'json'，手动 JSON.parse。
 * 原因是 uni 内部自动 parse 会构造 UTSJSONObject，若 JSON 中存在与只读成员同名的 key（如 get）会报错；
 * 当前后端文档结构已拍平，但保留手动解析以避免框架解析差异。
 */
function request(url: string): Promise<any> {
  return new Promise((resolve) => {
    uni.request({
      url,
      success: (res) => {
        resolve(res.data)
      }
    })
  })
}

/**
 * 获取 API 列表（后端返回拍平结构 { tags, apis }，method 为字符串值，避开 UTSJSONObject 只读 key 冲突）
 */
const onGetApi = () => {
  request(state.swagger + "/v3/api-docs")
    .then((res : any) => {
      uni.showToast({
        title: "获取API缓存到本地中",
        icon: "none"
      })
      state.apis = []
      const list = res.apis as Array<any>
      if (list != null) {
        list.forEach((item: any) => {
          const apis: ApiItem = {
            description: (item.description ?? "") as string,
            tags: (item.tags ?? "") as string,
            summary: (item.summary ?? "") as string,
            url: (item.path ?? "") as string,
            method: (item.method ?? "") as string,
            parameters: item.parameters != null ? item.parameters as ApiParameter[] : [],
            proxy: state.swagger
          }
          state.apis.push(apis)
        })
      }
    })
    .catch((error) => {
      console.debug("error:", error)
    })
}

/**
 * 生成函数名：请求方式前缀 + 路径大驼峰
 * 同一路径不同请求方式（GET/POST/PUT/DELETE /student）必须产生不同函数名，否则会重名
 * 例：GET /student/{id} -> getStudentId，DELETE /student/{id} -> deleteStudentId
 */
const onFunctionName = (url: string, method: string): string => {
  return onMethodVerb(method) + onPathToPascal(url)
}

/**
 * 请求方式转函数名前缀
 */
const onMethodVerb = (method: string): string => {
  const m = method.toUpperCase()
  if (m === "GET") {
    return "get"
  }
  if (m === "POST") {
    return "post"
  }
  if (m === "PUT") {
    return "update"
  }
  if (m === "DELETE") {
    return "delete"
  }
  return m.toLowerCase()
}

/**
 * URL 转大驼峰（/ 与 - 与 _ 均作为单词分隔，{id} 只保留参数名）
 * 例：/student/{id} -> StudentId，/order/{id}/pay-code -> OrderIdPayCode
 */
const onPathToPascal = (url: string): string => {
  const cleanPath = url
    .replace(/\{/g, "")
    .replace(/\}/g, "")
    .replace(/-/g, "/")
    .replace(/_/g, "/")
  const parts = cleanPath.split("/")
  let name = ""
  for (let i = 0; i < parts.length; i++) {
    const part = parts[i]
    if (part.length === 0) {
      continue
    }
    name += part.charAt(0).toUpperCase() + part.substring(1)
  }
  return name
}

/**
 * 生成单个接口的纯文本代码
 * 页面上展示的是分节点高亮代码，从控件选中复制会丢失排版，
 * 因此复制统一走这里拼接的纯文本，保证粘贴结果与图片一致
 */
const onBuildCode = (api: ApiItem): string => {
  let code = "/**\n"
  code += "* 接口分类: " + api.description + " - " + api.tags + "\n"
  code += "* 接口名称: " + api.summary + "\n"
  code += "* 接口地址: " + api.url + "\n"
  code += "* 请求方式: " + api.method + "\n"
  for (let i = 0; i < api.parameters.length; i++) {
    const parame = api.parameters[i]
    code += "* @param {" + parame.type + "} " + parame.name + " [" + parame.description + "] 是否必填: " + (parame.required ? "是" : "否") + "\n"
  }
  code += "* @return {Promise<any>} 接口响应数据\n"
  code += "*/\n"
  code += "export function " + onFunctionName(api.url, api.method) + "(data: any = {}) {\n"
  code += "  return request('" + api.url + "', data, '" + api.method + "');\n"
  code += "}\n"
  return code
}


/**
 * 拼接接口代码列表（顶部带 import）
 */
const onBuildCodeList = (list: ApiItem[]): string => {
  let code = "import request from '@/utils/request';\n\n"
  for (let i = 0; i < list.length; i++) {
    code += onBuildCode(list[i]) + "\n"
  }
  return code
}

/**
 * 搜索
 */
const onSearch = () => {
  state.searchApi = onFuzzyQuery(state.apis, state.search.trim())
  if (state.searchApi.length === 0) {
    uni.showToast({
      title: "未搜索到接口数据",
      icon: "none"
    })
  }
}

/**
 * 模糊查询
 * 按 url + method 去重，保证同一路径的不同请求方式都能展示
 */
const onFuzzyQuery = (list: ApiItem[], keyWord: string): ApiItem[] => {
  const arr: ApiItem[] = []
  for (let i = 0; i < list.length; i++) {
    if (keyWord.length === 0) {
      arr.push(list[i])
      continue
    }
    if (list[i].summary.split(keyWord).length > 1) {
      arr.push(list[i])
    } else if (
      list[i].description.split(keyWord).length > 1 &&
      arr.map((item) => item.url + item.method).indexOf(list[i].url + list[i].method) === -1
    ) {
      arr.push(list[i])
    } else if (
      list[i].tags.split(keyWord).length > 1 &&
      arr.map((item) => item.url + item.method).indexOf(list[i].url + list[i].method) === -1
    ) {
      arr.push(list[i])
    } else if (
      list[i].url.split(keyWord).length > 1 &&
      arr.map((item) => item.url + item.method).indexOf(list[i].url + list[i].method) === -1
    ) {
      arr.push(list[i])
    }
  }
  return arr
}

onGetApi()
</script>
