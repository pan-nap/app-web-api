// ========== hs-md5 UTS插件 - Web平台入口 ==========
// 纯 UTS 实现 RFC 1321 MD5（Web Crypto 的 digest 是异步的，无法用于同步请求防抖 key）
// 本目录仅在 Web（UTS→TypeScript）编译，位运算使用标准 32 位 JS 语义

export class Md5Service {
	/** 计算字符串的 MD5 摘要（32 位小写十六进制），输入为空时返回空字符串 */
	static hash(input: string | null): string {
		if (input == null) return "";
		return md5Sum(stringToUtf8Bytes(input!));
	}
}

// ========== 基础工具 ==========

/** 32 位循环左移 */
function rotl32(x: number, s: number): number {
	const v = x | 0;
	return (v << s) | (v >>> (32 - s)) | 0;
}

/** 每轮左移位数表（下标 i % 4） */
function getShift(round: number, i: number): number {
	if (round == 0) {
		const t = [7, 12, 17, 22];
		return t[i % 4];
	} else if (round == 1) {
		const t = [5, 9, 14, 20];
		return t[i % 4];
	} else if (round == 2) {
		const t = [4, 11, 16, 23];
		return t[i % 4];
	}
	const t = [6, 10, 15, 21];
	return t[i % 4];
}

/** 字符串转 UTF-8 字节数组（手动编码，不依赖 TextEncoder；孤立代理按 U+FFFD 替换，与 TextEncoder 一致） */
function stringToUtf8Bytes(str: string): number[] {
	const bytes: number[] = [];
	const len = str.length;
	for (let i = 0; i < len; i++) {
		let code: number = str.charCodeAt(i) as number;
		if (code < 0x80) {
			bytes.push(code);
		} else if (code < 0x800) {
			bytes.push(0xc0 | (code >> 6));
			bytes.push(0x80 | (code & 0x3f));
		} else if (code < 0xd800 || code >= 0xe000) {
			bytes.push(0xe0 | (code >> 12));
			bytes.push(0x80 | ((code >> 6) & 0x3f));
			bytes.push(0x80 | (code & 0x3f));
		} else if (code >= 0xdc00 || i + 1 >= len) {
			// 孤立低位代理，或高位代理位于末尾：输出替换字符 U+FFFD
			bytes.push(0xef);
			bytes.push(0xbf);
			bytes.push(0xbd);
		} else {
			const code2: number = str.charCodeAt(i + 1) as number;
			if (code2 >= 0xdc00 && code2 <= 0xdfff) {
				i++;
				code = 0x10000 + (((code & 0x3ff) << 10) | (code2 & 0x3ff));
				bytes.push(0xf0 | (code >> 18));
				bytes.push(0x80 | ((code >> 12) & 0x3f));
				bytes.push(0x80 | ((code >> 6) & 0x3f));
				bytes.push(0x80 | (code & 0x3f));
			} else {
				// 高位代理后未跟低位代理：输出替换字符，且不消费下一个字符
				bytes.push(0xef);
				bytes.push(0xbf);
				bytes.push(0xbd);
			}
		}
	}
	return bytes;
}

/**
 * K 表：floor(abs(sin(i+1)) * 2^32)，RFC 1321 标准常量，以有符号 32 位字面量硬编码
 * （>2^31 的项写成 `0x... - 0x100000000`，保证转译到 Kotlin 时字面量不超 Int 范围）
 */
function getKTable(): number[] {
	return [
		0xd76aa478 - 0x100000000,
		0xe8c7b756 - 0x100000000,
		0x242070db,
		0xc1bdceee - 0x100000000,
		0xf57c0faf - 0x100000000,
		0x4787c62a,
		0xa8304613 - 0x100000000,
		0xfd469501 - 0x100000000,
		0x698098d8,
		0x8b44f7af - 0x100000000,
		0xffff5bb1 - 0x100000000,
		0x895cd7be - 0x100000000,
		0x6b901122,
		0xfd987193 - 0x100000000,
		0xa679438e - 0x100000000,
		0x49b40821,
		0xf61e2562 - 0x100000000,
		0xc040b340 - 0x100000000,
		0x265e5a51,
		0xe9b6c7aa - 0x100000000,
		0xd62f105d - 0x100000000,
		0x02441453,
		0xd8a1e681 - 0x100000000,
		0xe7d3fbc8 - 0x100000000,
		0x21e1cde6,
		0xc33707d6 - 0x100000000,
		0xf4d50d87 - 0x100000000,
		0x455a14ed,
		0xa9e3e905 - 0x100000000,
		0xfcefa3f8 - 0x100000000,
		0x676f02d9,
		0x8d2a4c8a - 0x100000000,
		0xfffa3942 - 0x100000000,
		0x8771f681 - 0x100000000,
		0x6d9d6122,
		0xfde5380c - 0x100000000,
		0xa4beea44 - 0x100000000,
		0x4bdecfa9,
		0xf6bb4b60 - 0x100000000,
		0xbebfbc70 - 0x100000000,
		0x289b7ec6,
		0xeaa127fa - 0x100000000,
		0xd4ef3085 - 0x100000000,
		0x04881d05,
		0xd9d4d039 - 0x100000000,
		0xe6db99e5 - 0x100000000,
		0x1fa27cf8,
		0xc4ac5665 - 0x100000000,
		0xf4292244 - 0x100000000,
		0x432aff97,
		0xab9423a7 - 0x100000000,
		0xfc93a039 - 0x100000000,
		0x655b59c3,
		0x8f0ccc92 - 0x100000000,
		0xffeff47d - 0x100000000,
		0x85845dd1 - 0x100000000,
		0x6fa87e4f,
		0xfe2ce6e0 - 0x100000000,
		0xa3014314 - 0x100000000,
		0x4e0811a1,
		0xf7537e82 - 0x100000000,
		0xbd3af235 - 0x100000000,
		0x2ad7d2bb,
		0xeb86d391 - 0x100000000
	];
}

/** 4 位 nibble 转十六进制字符 */
function nibbleToHex(n: number): string {
	if (n < 10) {
		return String.fromCharCode(48 + n);
	}
	return String.fromCharCode(87 + n);
}

/** 32 位整数按小端字节序追加 8 个十六进制字符 */
function appendHexLE(hex: string[], word: number): void {
	for (let j = 0; j < 8; j += 2) {
		const byte = (word >>> (j * 4)) & 0xff;
		hex.push(nibbleToHex((byte >>> 4) & 0xf));
		hex.push(nibbleToHex(byte & 0xf));
	}
}

// ========== MD5 核心 ==========

/**
 * 对单个 64 字节分组执行压缩函数
 * 入参 state = [a, b, c, d]，返回更新后的 [a, b, c, d]
 */
function transformBlock(words: number[], kTable: number[], state: number[]): number[] {
	let a = state[0];
	let b = state[1];
	let c = state[2];
	let d = state[3];

	for (let i = 0; i < 64; i++) {
		const round = Math.floor(i / 16);
		let f = 0;
		let g = 0;
		if (round == 0) {
			f = (b & c) | (~b & d);
			g = i;
		} else if (round == 1) {
			f = (d & b) | (~d & c);
			g = (5 * i + 1) % 16;
		} else if (round == 2) {
			f = b ^ c ^ d;
			g = (3 * i + 5) % 16;
		} else {
			f = c ^ (b | ~d);
			g = (7 * i) % 16;
		}
		// FF/GG/HH/II 标准变换：a = b + rotl(a + f + K[i] + M[g], s)
		const sum = (((a + f) | 0) + ((kTable[i] + words[g]) | 0)) | 0;
		const rotated = rotl32(sum, getShift(round, i));
		const newA = (b + rotated) | 0;
		a = d;
		d = c;
		c = b;
		b = newA;
	}
	return [a, b, c, d];
}

/** 计算字节数组的 MD5，返回 32 位小写十六进制 */
function md5Sum(bytes: number[]): string {
	// 1. 填充：追加 0x80，补零至 length % 64 == 56，最后 8 字节为原始比特长度（低位在前）
	const bitLenLo = bytes.length * 8;
	const padded = bytes.slice(0);
	padded.push(0x80);
	while (padded.length % 64 != 56) {
		padded.push(0);
	}
	for (let i = 0; i < 4; i++) {
		padded.push((bitLenLo >>> (i * 8)) & 0xff);
	}
	// 长度高 32 位（防抖 key 远小于 512MB，恒为 0）
	for (let i = 0; i < 4; i++) {
		padded.push(0);
	}

	// 2. 初始化链接变量 A=0x67452301 B=0xEFCDAB89 C=0x98BADCFE D=0x10325476（有符号 32 位表示）
	let state = [0x67452301, -271733879, -1732584194, 271733878];
	const kTable = getKTable();

	// 3. 按 64 字节分组处理
	for (let offset = 0; offset < padded.length; offset += 64) {
		// 小端序组装 16 个 32 位消息字
		const words: number[] = [];
		for (let w = 0; w < 16; w++) {
			const base = offset + w * 4;
			words.push((padded[base + 3] << 24) | (padded[base + 2] << 16) | (padded[base + 1] << 8) | padded[base]);
		}
		// 压缩后叠加链接变量
		const out = transformBlock(words, kTable, state);
		state = [(state[0] + out[0]) | 0, (state[1] + out[1]) | 0, (state[2] + out[2]) | 0, (state[3] + out[3]) | 0];
	}

	// 4. 输出小端十六进制
	const hex: string[] = [];
	for (let i = 0; i < 4; i++) {
		appendHexLE(hex, state[i]);
	}
	return hex.join("");
}
