// ========== hs-md5 UTS插件 - Android平台入口 ==========
// 直接使用 JDK 原生 MessageDigest 实现 MD5

import MessageDigest from "java.security.MessageDigest";

/** 字节值(0~255) -> 两位小写十六进制，避免逐字节 toString 的补零问题 */
function buildHexByteTable(): string[] {
	const digits = "0123456789abcdef";
	const table: string[] = [];
	for (let i = 0; i < 256; i++) {
		table.push(digits.charAt(Math.floor(i / 16)) + digits.charAt(i % 16));
	}
	return table;
}

export class Md5Service {
	/** 计算字符串的 MD5 摘要（32 位小写十六进制），输入为空时返回空字符串 */
	static hash(input: string | null): string {
		if (input == null) return "";
		const digest = MessageDigest.getInstance("MD5");
		// UTS 的 string 类型没有 getBytes，需先转为 java.lang.String 再按 UTF-8 取字节
		const javaStr = input! as java.lang.String;
		const bytes = digest.digest(javaStr.getBytes("UTF-8"));
		const hexTable = buildHexByteTable();
		let hex = "";
		// Kotlin ByteArray 用 size 取长度；索引要求 Int，number 会报类型不匹配
		for (let i: Int = 0; i < bytes.size; i++) {
			// Kotlin Byte 有符号，+256 归一为 0~255
			let v = bytes[i] as number;
			if (v < 0) v = v + 256;
			hex = hex + hexTable[v];
		}
		return hex;
	}
}
