import request from "@/utils/request.uts";
import { showToast } from "@/utils/tool.uts";

export type Student = {
  id: string;
  name: string;
  idCard: string;
  gender: string;
  age: number;
  className: string;
  studentNo: string;
};

export type StudentInfo = {
  idCard: string;
  list: Student[];
};

const studentInfo = reactive<StudentInfo>({
  idCard: "",
  list: []
});

function toStudent(data: Record<string, any>): Student {
  return {
    id: (data.id ?? "") as string,
    name: (data.name ?? "") as string,
    idCard: (data.idCard ?? "") as string,
    gender: (data.gender ?? "") as string,
    age: (data.age ?? 0) as number,
    className: (data.className ?? "") as string,
    studentNo: (data.studentNo ?? "") as string
  };
}

class StudentStore {
  state: StudentInfo = studentInfo;

  async queryByIdCard(idCard: string): Promise<Student[]> {
    try {
      const res = await request("/student", { idCard }, "GET");
      const rawArray = res as Record<string, any>[];
      const list = rawArray.map((item): Student => {
        return toStudent(item);
      });
      this.state.list = list;
      return list;
    } catch (err) {
      console.log("查询学生失败=>>>>>", err);
      showToast("查询学生失败");
      return [];
    }
  }
}

const studentStore = new StudentStore();

export function useStudentStore(): StudentStore {
  return studentStore;
}
