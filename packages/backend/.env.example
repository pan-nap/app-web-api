# 后端服务端口
PORT=3001

# MySQL 连接（替换为真实值；切勿把含密钥的 .env 提交到公开仓库）
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=student_manage

# JWT
JWT_SECRET=change_me
JWT_EXPIRES_IN=7d

# PACS 内核切换：mini = P1 磁盘+MySQL mini-PACS（默认） | orthanc = Orthanc 内核
PACS_BACKEND=orthanc

# Orthanc 内核连接（本地测试，默认无认证；生产应启用认证并设 ORTHANC_USER/PASSWORD）
ORTHANC_URL=http://localhost:8042
ORTHANC_USER=
ORTHANC_PASSWORD=
ORTHANC_AET=HS_PACS
ORTHANC_DICOM_PORT=4242
ORTHANC_DICOMWEB_ROOT=/dicom-web
ORTHANC_TIMEOUT_MS=30000